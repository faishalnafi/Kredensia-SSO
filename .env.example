# ============================================================
# SSO Sekolah — Environment Configuration Template
# Besutan  : Faishal Nafi Network (https://faishalnafi.com)
# Versi    : v1.0.0 | Production | Community Edition
#
# Salin file ini menjadi .env dan sesuaikan dengan kebutuhan Anda.
# JANGAN commit file .env ke repositori!
# ============================================================

# ── Aplikasi ──────────────────────────────────────────────────
APP_NAME="SSO Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────
# DATABASE UTAMA
# Pilih salah satu: mysql | mariadb | pgsql | sqlite
# ──────────────────────────────────────────────────────────────

# ── Opsi 1: MySQL / MariaDB (Direkomendasikan) ────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sso_sekolah
DB_USERNAME=root
DB_PASSWORD=

# ── Opsi 2: PostgreSQL ────────────────────────────────────────
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=sso_sekolah
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=prefer

# ── Opsi 3: SQLite (Development / Testing) ───────────────────
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# ──────────────────────────────────────────────────────────────
# CACHE & SESSION
# Pilih driver: database | redis | mongodb | dynamodb | file
# ──────────────────────────────────────────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
# Tidak dipakai lagi - durasi sesi dikunci hardcode 44640 (31 hari) di config/session.php
SESSION_LIFETIME=44640
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ── Redis (Cache / Session / Queue Tercepat) ──────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Aktifkan Redis: CACHE_STORE=redis, SESSION_DRIVER=redis, QUEUE_CONNECTION=redis

# ──────────────────────────────────────────────────────────────
# MONGODB — Cache / Session Store Alternatif
# Aktifkan dengan: CACHE_STORE=mongodb
# Install: composer require mongodb/laravel-mongodb
# Pastikan ekstensi PHP mongodb aktif: pecl install mongodb
# ──────────────────────────────────────────────────────────────
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=sso_sekolah
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_CACHE_COLLECTION=sso_cache

# ──────────────────────────────────────────────────────────────
# AMAZON DYNAMODB — Cache / Session Store Serverless
# Aktifkan dengan: CACHE_STORE=dynamodb
# Buat tabel DynamoDB: Table=sso_cache, PK=key (String), TTL=expires_at
# ──────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
DYNAMODB_CACHE_TABLE=sso_cache
# DYNAMODB_ENDPOINT=http://localhost:8000  # Uncomment untuk DynamoDB Local (testing)

# ── Queue Connection ──────────────────────────────────────────
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Memcached (Opsional) ──────────────────────────────────────
MEMCACHED_HOST=127.0.0.1

# ── Mail ──────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────
# GOOGLE SERVICES
# ──────────────────────────────────────────────────────────────

# ── Google OAuth 2.0 (Untuk tombol "Login dengan Google") ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── Google reCAPTCHA Enterprise (Invisible Anti-Bot) ─────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5

# ──────────────────────────────────────────────────────────────
# REAL-TIME (WebSocket / Polling Fallback)
# ──────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_BROADCAST_CONNECTION=reverb

# ── Opsi A: Laravel Reverb (WebSocket Lokal) ──────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Opsi B: Pusher (WebSocket Cloud) ─────────────────────────
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=ap1
# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
