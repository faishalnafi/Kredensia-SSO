<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================
    SSO Sekolah — Microsoft IIS Configuration (web.config)
    Besutan  : Faishal Nafi Network (https://faishalnafi.com)
    Versi    : v1.0.0 | Compatible: IIS 10+ (Windows Server 2016+)

    Prasyarat IIS:
    - Module: URL Rewrite 2.1+  (dari IIS Extensions)
    - Module: FastCGI (built-in IIS)
    - PHP Manager untuk IIS (opsional, untuk manajemen versi PHP)
    - Handler: PHP 8.2+ via FastCGI

    Cara Install URL Rewrite Module:
    1. Buka IIS Manager → Server → Modules
    2. Klik "Install New" dan cari "URL Rewrite"
    Atau unduh dari: https://www.iis.net/downloads/microsoft/url-rewrite
    ============================================================
-->
<configuration>
    <system.webServer>

        <!-- ── Dokumen Default ──────────────────────────────── -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <!-- ── Sembunyikan Listing Direktori ────────────────── -->
        <directoryBrowse enabled="false" />

        <!-- ── URL Rewrite: Routing Laravel ─────────────────── -->
        <rewrite>
            <rules>
                <!-- Izinkan akses langsung ke file/folder yang ada -->
                <rule name="Izinkan Aset Statis" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
                    </conditions>
                    <action type="None" />
                </rule>

                <!-- Arahkan semua request lain ke index.php (Front Controller) -->
                <rule name="Laravel Front Controller" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <action type="Rewrite" url="index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>

        <!-- ── Security Headers ──────────────────────────────── -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <remove name="Server" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-XSS-Protection" value="1; mode=block" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
            </customHeaders>
        </httpProtocol>

        <!-- ── Blokir Akses ke File Sensitif ─────────────────── -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment=".git" />
                    <add segment="storage" />
                    <add segment="bootstrap/cache" />
                    <add segment="vendor" />
                    <add segment="node_modules" />
                </hiddenSegments>
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".env" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <!-- ── Kompresi (Static + Dynamic) ──────────────────── -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <!-- ── Handler PHP via FastCGI ───────────────────────── -->
        <handlers>
            <remove name="PHP_via_FastCGI" />
            <add name="PHP_via_FastCGI"
                 path="*.php"
                 verb="GET,HEAD,POST,PUT,DELETE,OPTIONS"
                 modules="FastCgiModule"
                 scriptProcessor="C:\php\php-cgi.exe"
                 resourceType="Either"
                 requireAccess="Script" />
        </handlers>

        <!-- ── Cache Browser untuk Aset Statis ───────────────── -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            <!-- Tambahkan MIME types yang mungkin belum ada -->
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>

        <!-- ── Halaman Error Kustom ───────────────────────────── -->
        <httpErrors errorMode="Custom" existingResponse="Replace">
            <remove statusCode="404" />
            <error statusCode="404" path="/index.php" responseMode="ExecuteURL" />
            <remove statusCode="500" />
            <error statusCode="500" path="/index.php" responseMode="ExecuteURL" />
        </httpErrors>

    </system.webServer>

    <system.web>
        <!-- ── Ukuran Upload Maksimum (20 MB) ────────────────── -->
        <httpRuntime maxRequestLength="20480" executionTimeout="300" />
    </system.web>
</configuration>
